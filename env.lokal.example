# Untuk menjalankan TAPAK di LAPTOP dengan MySQL lokal (bukan untuk srv-web).
# Salin menjadi .env di folder proyek:  copy env.lokal.example .env   (PowerShell)
# .env tidak ikut di-commit (lihat .gitignore).
#
# Isi sandi sama dengan yang dipakai saat membuat user MySQL (docker-compose.yml atau db/init-lokal.sql).
# Karakter khusus di sandi harus di-URL-encode: # -> %23, @ -> %40, / -> %2F, : -> %3A.
DATABASE_URL=mysql://toko:tokolokal2026@127.0.0.1:3306/toko
SECRET_KEY=lokal-ganti-bebas
# Di laptop, log dan unggahan disimpan di folder proyek (logs/ dan uploads/, sudah diabaikan Git).
# VULN_* tidak diisi = semua celah tertutup (0).
